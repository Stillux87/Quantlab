{
  "entities": {
    "PaperTradingSession": {
      "title": "PaperTradingSession",
      "description": "A persistent automated paper trading session running on the server",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique session identifier" },
        "strategyId": { "type": "string", "description": "Identifier of the trading strategy" },
        "strategyName": { "type": "string", "description": "Name of the strategy" },
        "strategyCategory": { "type": "string", "description": "Strategy classification" },
        "instrument": { "type": "object", "description": "Financial asset definition" },
        "timeframe": { "type": "string", "description": "Selected timeframe interval" },
        "params": { "type": "object", "description": "Custom strategy parameters" },
        "createdAt": { "type": "number", "description": "Creation timestamp in ms" },
        "startedAt": { "type": "number", "description": "Start timestamp in ms" },
        "isActive": { "type": "boolean", "description": "Whether the session is currently active" },
        "isPaused": { "type": "boolean", "description": "Whether execution is temporarily paused" },
        "initialCapital": { "type": "number", "description": "Starting cash balance" },
        "currentCapital": { "type": "number", "description": "Current cash balance" },
        "riskPerTradePct": { "type": "number", "description": "Risk percentage per trade" },
        "commissionPct": { "type": "number", "description": "Commission percentage per order" },
        "slippagePct": { "type": "number", "description": "Slippage percentage per order" },
        "openPositions": { "type": "array", "description": "List of active positions" },
        "closedTrades": { "type": "array", "description": "List of completed trades" },
        "logs": { "type": "array", "description": "Chronological execution and decision logs" },
        "alerts": { "type": "array", "description": "System and trade alert notifications" },
        "equityHistory": { "type": "array", "description": "Historical equity progression" },
        "lastBarProcessed": { "type": "object", "description": "Last evaluated candle bar" },
        "lastServerTick": { "type": "number", "description": "Timestamp of last server tick" },
        "isConsolidated": { "type": "boolean", "description": "Whether session is consolidated into multi-asset portfolio" },
        "consolidatedIntoSessionId": { "type": "string", "description": "ID of parent portfolio session" },
        "regimeFilter": { "type": "object", "description": "Macro regime gating configuration and status" }
      },
      "required": ["id", "strategyId", "instrument", "timeframe", "initialCapital", "currentCapital", "isActive"]
    },
    "ServerState": {
      "title": "ServerState",
      "description": "Background trading engine status and heartbeat",
      "type": "object",
      "properties": {
        "lastHeartbeat": { "type": "number", "description": "Last worker heartbeat in ms" },
        "activeSessionsCount": { "type": "number", "description": "Count of running background strategies" },
        "serverStatus": { "type": "string", "description": "Worker status string" }
      },
      "required": ["lastHeartbeat", "serverStatus"]
    },
    "SavedStrategyPreset": {
      "title": "SavedStrategyPreset",
      "description": "User saved optimized trading strategy preset",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique preset identifier" },
        "name": { "type": "string", "description": "User given name" },
        "description": { "type": "string", "description": "Optional strategy notes" },
        "strategyId": { "type": "string", "description": "Strategy algorithm identifier" },
        "strategyName": { "type": "string", "description": "Display name of strategy algorithm" },
        "instrument": { "type": "object", "description": "Target financial asset" },
        "timeframe": { "type": "string", "description": "Timeframe interval" },
        "dateRange": { "type": "object", "description": "Optimization date range window" },
        "params": { "type": "object", "description": "Optimized hyper-parameters" },
        "originalMetrics": { "type": "object", "description": "Backtest metrics at time of save" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "tags": { "type": "array", "description": "Labels or tags" }
      },
      "required": ["id", "name", "strategyId", "instrument", "timeframe", "params", "originalMetrics", "createdAt"]
    }
  },
  "firestore": {
    "/paper_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/PaperTradingSession" },
      "description": "Collection of all paper trading sessions tracked by the 24/7 backend server"
    },
    "/server_state/{stateId}": {
      "schema": { "$ref": "#/entities/ServerState" },
      "description": "Server health and background ticker telemetry"
    },
    "/saved_strategies/{strategyId}": {
      "schema": { "$ref": "#/entities/SavedStrategyPreset" },
      "description": "User saved optimized strategies collection"
    }
  }
}
