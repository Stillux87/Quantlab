{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated QuantLab user profile with isolated PII and non-self-escalating role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["viewer", "trader", "admin"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "PaperSession": {
      "title": "PaperSession",
      "description": "Persistent real-market paper trading session scoped to its ownerUid.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "strategyId": { "type": "string" },
        "strategyName": { "type": "string" },
        "strategyCategory": { "type": "string" },
        "instrument": { "type": "object" },
        "timeframe": { "type": "string" },
        "params": { "type": "object" },
        "createdAt": { "type": "number" },
        "startedAt": { "type": "number" },
        "isActive": { "type": "boolean" },
        "isPaused": { "type": "boolean" },
        "initialCapital": { "type": "number" },
        "currentCapital": { "type": "number" },
        "riskPerTradePct": { "type": "number" },
        "commissionPct": { "type": "number" },
        "slippagePct": { "type": "number" },
        "openPositions": { "type": "array" },
        "closedTrades": { "type": "array" },
        "logs": { "type": "array" },
        "alerts": { "type": "array" },
        "equityHistory": { "type": "array" }
      },
      "required": ["id", "ownerUid", "strategyId", "strategyName", "timeframe", "initialCapital", "currentCapital", "isActive", "isPaused", "createdAt"]
    },
    "SavedStrategy": {
      "title": "SavedStrategy",
      "description": "User-saved quantitative strategy preset scoped to ownerUid.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerUid": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "strategyId": { "type": "string" },
        "strategyName": { "type": "string" },
        "instrument": { "type": "object" },
        "timeframe": { "type": "string" },
        "createdAt": { "type": "string" },
        "tags": { "type": "array" }
      },
      "required": ["id", "ownerUid", "name", "strategyId", "strategyName", "timeframe", "createdAt"]
    },
    "ServerState": {
      "title": "ServerState",
      "description": "Global background trading worker heartbeat and runtime state (admin write only).",
      "type": "object",
      "properties": {
        "lastHeartbeat": { "type": "number" },
        "activeSessionsCount": { "type": "number" },
        "serverStatus": { "type": "string" },
        "tickCount": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["lastHeartbeat", "activeSessionsCount", "serverStatus", "tickCount"]
    },
    "AiAutopilotState": {
      "title": "AiAutopilotState",
      "description": "AI Portfolio Manager configuration, verified market briefings, and decision log (admin write only).",
      "type": "object",
      "properties": {
        "config": { "type": "object" },
        "lastRunAt": { "type": "number" },
        "lastBriefingAt": { "type": "number" },
        "eurUsdRate": { "type": "number" },
        "briefings": { "type": "array" },
        "decisions": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["config", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "type": "object" },
      "description": "Trusted administrator UID registry."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user profile documents."
    },
    "/paper_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/PaperSession" },
      "description": "Owner-scoped real-market paper trading sessions."
    },
    "/saved_strategies/{strategyId}": {
      "schema": { "$ref": "#/entities/SavedStrategy" },
      "description": "Owner-scoped saved quantitative strategies."
    },
    "/server_state/{stateId}": {
      "schema": { "$ref": "#/entities/ServerState" },
      "description": "Server worker heartbeat and status metadata."
    },
    "/ai_autopilot/{docId}": {
      "schema": { "$ref": "#/entities/AiAutopilotState" },
      "description": "Autonomous AI autopilot state, briefings, and decision audit trail."
    }
  }
}
